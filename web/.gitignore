node_modules/
dist/
test-results/
playwright-report/
*.local
dist-test/
# Copied from node_modules/@mediapipe/tasks-vision by scripts/vendor-mediapipe.mjs
public/mediapipe/wasm/
# Fake-camera clips generated by the e2e tests
e2e/fixtures/*.y4m
# Third-party sample photo with no stated licence: fetched by the tests, never committed
e2e/fixtures/*.jpg
# API keys: only the names in .env.example are committed
.env
.env.*
!.env.example
# Screenshots, JSON reports and videos written by the e2e tests (EVIDENCE_DIR overrides it).
# No trailing slash, so the rules hold (and git check-ignore answers) before the folders exist.
/evidence
# Scratch output of the S5 regression runs
/.s5-regress
# ElevenLabs audio for fixed console lines, cached by the key server (server/index.mjs)
/.voice-cache
# Nano Banana skin images, cached by the key server (server/skin.mjs). Paid images: never commit.
/.skin-cache
