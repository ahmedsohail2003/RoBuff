# Copy this file to web/.env and fill in your own values. web/.env is git-ignored.
# Every key is optional. The app runs without any of them.

# Google Gemini, for object specs from a spoken or typed request
GEMINI_API_KEY=
# ElevenLabs, for the console's spoken lines
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Vultr, only for deploying the site
VULTR_API_KEY=
